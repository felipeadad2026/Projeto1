{
  "app": {
    "name": "Resumo e Gráficos com GPT",
    "type": "workflow",
    "version": "1.0.0",
    "description": "Fluxo Dify que lê arquivos enviados pelo usuário, roteia entre resumo textual ou geração de gráficos e devolve a resposta formatada."
  },
  "nodes": [
    {
      "id": "start",
      "type": "input",
      "title": "Start",
      "form": {
        "fields": [
          {"id": "prompt_usuario", "type": "paragraph", "label": "Prompt do usuário", "required": true},
          {"id": "arquivos", "type": "file", "label": "Arquivos", "multiple": true, "required": true}
        ]
      },
      "next": ["ingestao"]
    },
    {
      "id": "ingestao",
      "type": "code",
      "title": "Ingestão",
      "language": "python",
      "source_path": "workflow/snippets/ingestao_arquivos.py",
      "inputs": {
        "arquivos": "{{start.arquivos}}"
      },
      "outputs": ["conteudo_concatenado", "metadados", "tabelas_disponiveis"],
      "next": ["router"]
    },
    {
      "id": "router",
      "type": "llm",
      "title": "Roteador",
      "model": "gpt-4o",
      "prompt_path": "workflow/prompts/router.txt",
      "inputs": {
        "prompt_usuario": "{{start.prompt_usuario}}",
        "conteudo_concatenado": "{{ingestao.conteudo_concatenado}}"
      },
      "outputs": ["tarefa"],
      "next": ["branch"]
    },
    {
      "id": "branch",
      "type": "condition",
      "title": "Decisão",
      "expression": "{{router.tarefa}} == 'resumo'",
      "true_next": ["resumo"],
      "false_next": ["graficos"]
    },
    {
      "id": "resumo",
      "type": "llm",
      "title": "Resumo",
      "model": "gpt-4o",
      "prompt_path": "workflow/prompts/resumo.txt",
      "inputs": {
        "prompt_usuario": "{{start.prompt_usuario}}",
        "ingestao.conteudo_concatenado": "{{ingestao.conteudo_concatenado}}"
      },
      "outputs": ["resposta_texto"],
      "next": ["resposta_final"]
    },
    {
      "id": "graficos",
      "type": "code",
      "title": "Preparar gráfico",
      "language": "python",
      "source_path": "workflow/snippets/graficos.py",
      "inputs": {
        "prompt_usuario": "{{start.prompt_usuario}}",
        "tabelas_disponiveis": "{{ingestao.tabelas_disponiveis}}"
      },
      "outputs": ["grafico_html", "explicacao"],
      "next": ["resposta_final"]
    },
    {
      "id": "resposta_final",
      "type": "response",
      "title": "Resposta",
      "mappings": [
        {"channel": "text", "from": "{{resumo.resposta_texto}}", "condition": "{{router.tarefa}} == 'resumo'"},
        {"channel": "text", "from": "{{graficos.explicacao}}", "condition": "{{router.tarefa}} != 'resumo'"},
        {"channel": "rich_text", "from": "{{graficos.grafico_html}}", "condition": "{{router.tarefa}} != 'resumo'"}
      ]
    }
  ]
}
